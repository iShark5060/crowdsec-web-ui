{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "jsx-a11y", "promise", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/*.generated.ts", "**/scripts/data/**"],
  // "warn" prints "warning", and run-quality-checks.mjs fails the run on that word,
  // so ported ESLint rules are "error". react/purity stays off: oxlint flags
  // `new Date()` during render, and those calls are the current time for date
  // presets and the search timezone offset.
  "rules": {
    "eslint/no-await-in-loop": "off",
    "eslint/no-shadow": "off",
    "eslint/no-underscore-dangle": "off",
    "eslint/preserve-caught-error": "off",
    "import/no-named-as-default": "off",
    "import/no-named-as-default-member": "off",
    "import/no-unassigned-import": "off",
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "jsx-a11y/interactive-supports-focus": "off",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/no-noninteractive-tabindex": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/role-has-required-aria-props": "off",
    "jsx-a11y/role-supports-aria-props": "off",
    "no-array-constructor": "error",
    "no-case-declarations": "error",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-prototype-builtins": "error",
    "no-regex-spaces": "error",
    "no-unused-vars": ["error", { "varsIgnorePattern": "^[A-Z_]", "argsIgnorePattern": "^_" }],
    "no-useless-assignment": "error",
    "no-var": "error",
    "prefer-const": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "promise/always-return": "off",
    "promise/no-callback-in-promise": "off",
    "promise/no-multiple-resolved": "off",
    "react/error-boundaries": "error",
    "react/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "off",
    "react/globals": "error",
    "react/iframe-missing-sandbox": "off",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/memo-dependencies": "off",
    "react/no-array-index-key": "off",
    "react/no-deriving-state-in-effects": "off",
    "react/no-object-type-as-default-prop": "off",
    "react/only-export-components": [
      "error",
      { "allowConstantExport": true, "allowCompoundComponents": true }
    ],
    "react/preserve-manual-memoization": "error",
    "react/purity": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "error",
    "react/rules-of-hooks": "error",
    "react/set-state-in-effect": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off",
    "vitest/valid-describe-callback": "off",
    "vitest/valid-title": "off",
    "vitest/expect-expect": ["warn", { "assertFunctionNames": ["expect", "expectFades"] }]
  },
  "overrides": [
    {
      "files": [
        "client/src/**/*.{ts,tsx}",
        "vite.config.ts",
        "vitest.config.ts",
        "vitest.server.config.ts",
        "vitest.client.config.ts",
        "tsup.config.ts"
      ],
      "rules": {
        "typescript/ban-ts-comment": "off",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "error",
        "typescript/no-namespace": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unsafe-function-type": "error"
      }
    }
  ]
}
